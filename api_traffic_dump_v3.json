        "query": "query CustomerByCustomerAccessToken($customerAccessToken: String!) {\n  customer(customerAccessToken: $customerAccessToken) {\n    id\n    firstName\n    lastName\n    acceptsMarketing\n    email\n    phone\n    tags\n    metafields(\n      identifiers: [{key: \"customer_string\", namespace: \"subscriptions\"}, {key: \"subscription_frequency\", namespace: \"club\"}, {key: \"subscription_frequency\", namespace: \"club\"}, {key: \"is_subscribed\", namespace: \"club\"}, {key: \"tier\", namespace: \"club\"}, {key: \"subscribe_to\", namespace: \"club\"}, {key: \"credits\", namespace: \"club\"}, {key: \"legacy\", namespace: \"club\"}, {key: \"legacy_expires_at\", namespace: \"club\"}]\n    ) {\n      namespace\n      key\n      value\n    }\n    orders(first: 100, reverse: true) {\n      edges {\n        node {\n          id\n          orderNumber\n          processedAt\n          shippingAddress {\n            address1\n            address2\n            city\n            company\n            country\n            countryCodeV2\n            formatted\n            formattedArea\n            zip\n            name\n            firstName\n            lastName\n            phone\n            id\n          }\n          subtotalPrice {\n            amount\n          }\n          totalShippingPrice {\n            amount\n          }\n          totalPriceV2 {\n            amount\n          }\n          fulfillmentStatus\n          shippingDiscountAllocations {\n            allocatedAmount {\n              amount\n            }\n          }\n          canceledAt\n          customAttributes {\n            key\n            value\n          }\n          lineItems(first: 100, reverse: true) {\n            edges {\n              node {\n                title\n                discountedTotalPrice {\n                  amount\n                }\n                originalTotalPrice {\n                  amount\n                }\n                variant {\n                  title\n                  imagesm: image {\n                    url(transform: {maxWidth: 300})\n                  }\n                  imagemd: image {\n                    url(transform: {maxWidth: 768})\n                  }\n                  imagelg: image {\n                    url(transform: {maxWidth: 1280})\n                  }\n                  price {\n                    amount\n                  }\n                  product {\n                    id\n                    title\n                    handle\n                    productType\n                    images(first: 10) {\n                      edges {\n                        node {\n                          url(transform: {maxWidth: 1280})\n                          altText\n                        }\n                      }\n                    }\n                    imagesmd: images(first: 10) {\n                      edges {\n                        node {\n                          url(transform: {maxWidth: 768})\n                        }\n                      }\n                    }\n                    imagessm: images(first: 10) {\n                      edges {\n                        node {\n                          url(transform: {maxWidth: 300})\n                          altText\n                        }\n                      }\n                    }\n                  }\n                }\n              }\n            }\n          }\n        }\n      }\n    }\n    defaultAddress {\n      address1\n      address2\n      city\n      company\n      country\n      countryCodeV2\n      formatted\n      formattedArea\n      zip\n      name\n      firstName\n      lastName\n      phone\n      id\n    }\n    addresses(first: 10, reverse: true) {\n      edges {\n        node {\n          address1\n          address2\n          city\n          company\n          country\n          countryCodeV2\n          formatted\n          formattedArea\n          zip\n          name\n          firstName\n          lastName\n          phone\n          id\n        }\n      }\n    }\n  }\n}",
